{
  "expo": {
    "name": "Back on Track",
    "slug": "backOnTrack",
    "scheme": "backontrack",
    "version": "1.2.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/d0a4dfc2-3743-440f-b129-b76e31351707"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.matheushnascimento.backOnTrack"
    },
    "android": {
      "bundler": "metro",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#F8F9FA"
      },
      "package": "com.matheushnascimento.backOnTrack"
    },
    "web": {
      "bundler": "metro",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-sqlite",
      "./plugins/withArm64Only.js",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#F8F9FA",
          "dark": {
            "image": "./assets/splash-icon.png",
            "backgroundColor": "#12161B"
          }
        }
      ]
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "d0a4dfc2-3743-440f-b129-b76e31351707"
      }
    }
  }
}
