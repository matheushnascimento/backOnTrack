{
  "compilerOptions": {
    "baseUrl": ".",
    "checkJs": true,
    "ignoreDeprecations": "6.0",
    "paths": {
      "@/*": ["./*"],
      "@images/*": ["./assets/images/*"]
    }
  },
  "extends": "expo/tsconfig.base",
  "exclude": [
    "node_modules",
    "dist",
    ".expo",
    "android",
    "ios",
    "babel.config.js",
    "metro.config.js",
    "jest.config.js",
    "tailwind.config.js",
    "eslint.config.mjs",
    "scripts",
    "plugins",
    "api"
  ]
}
